{
  "name": "vscblood",
  "displayName": "vscblood",
  "description": "Blood Engine - Visual Studio Code Extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
		"workspaceContains:.blood"
	],
  "contributes": {
    "commands": [
      { "command": "vscblood.build_run", "title": "Blood: BuildAndRun" }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.78.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.0.4",
    "@vscode/test-electron": "^2.3.0"
  }
}
